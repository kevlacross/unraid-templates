<?xml version='1.0' encoding='utf-8'?>
<Container version="2">
  <Name>Ecowitt Share to MQTT</Name>
  <Repository>ghcr.io/kevlacross/ecowitt-share-to-mqtt:latest</Repository>
  <Registry>https://ghcr.io</Registry>
  <Network>bridge</Network>
  <MyIP />
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Project>https://github.com/kevlacross/ecowitt-share-to-mqtt</Project>
  <Support>https://github.com/kevlacross/ecowitt-share-to-mqtt/issues</Support>
  <Overview>Bridge Ecowitt shared-station data to MQTT with Home Assistant MQTT Discovery.</Overview>
  <Description>Read one or more Ecowitt weather stations shared with you, select their detected sensors in the local web UI, publish values to MQTT, and create Home Assistant devices automatically through MQTT Discovery. Configuration and the SQLite database are persistent under /config.</Description>
  <Category>HomeAutomation: Tools:Utilities</Category>
  <WebUI>http://[IP]:[PORT:8080]</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/kevlacross/unraid-templates/main/templates/ecowitt-share-to-mqtt.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/kevlacross/unraid-templates/main/ecowitt/icon.svg</Icon>
  <Config Name="WebUI Port" Target="8080" Default="8080" Mode="tcp" Description="Local administration interface" Type="Port" Display="always" Required="true" Mask="false">8080</Config>
  <Config Name="Configuration" Target="/config" Default="/mnt/user/appdata/Ecowitt-share_to_MQTT" Mode="rw" Description="Persistent configuration and SQLite database" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/Ecowitt-share_to_MQTT</Config>
  <Config Name="Timezone" Target="TZ" Default="Etc/UTC" Mode="" Description="Timezone used for local display and logs" Type="Variable" Display="advanced" Required="false" Mask="false">Etc/UTC</Config>
  <ReadMe>https://github.com/kevlacross/unraid-templates/blob/main/ecowitt/README.md</ReadMe>
</Container>